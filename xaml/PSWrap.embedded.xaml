                                                        FontSize="11" FontWeight="SemiBold"
                                                        VerticalAlignment="Center" />
                                                    <TextBlock x:Name="lblSrcSize" Grid.Column="1"
                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                        FontSize="11" Margin="12,0,0,0"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Name="btnCompile" Style="{StaticResource BtnPrimary}"
                                            Margin="0,0,8,0" Height="36" MinWidth="140" Padding="16,0"
                                            ToolTip="Compile to native EXE">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Stretch="Uniform" Width="14" Height="14"
                                                    Fill="White" Data="M8 5v14l11-7z" Margin="0,0,6,0"
                                                    VerticalAlignment="Center" />
                                                <TextBlock Text="Compile to EXE"
                                                    VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnOpenOut" Style="{StaticResource BtnGreen}"
                                            Margin="0,0,8,0" Height="36" Padding="12,0"
                                            ToolTip="Open output folder">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Stretch="Uniform" Width="14" Height="14"
                                                    Fill="White"
                                                    Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"
                                                    Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Open Output" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="btnClear" Style="{StaticResource BtnOutline}"
                                            Height="36" Padding="12,0" ToolTip="Reset all fields">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Stretch="Uniform" Width="14" Height="14"
                                                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                    Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Clear" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="btnSettings" Style="{StaticResource BtnOutline}"
                                        Height="36" Padding="14,0"
                                        ToolTip="Open advanced build settings">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Stretch="Uniform" Width="14" Height="14"
                                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.488.488 0 00-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94L14.4 2.81a.484.484 0 00-.41-.3h-3.84c-.17 0-.33.09-.41.28l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.08.19.24.3.41.3h3.84c.17 0 .33-.09.41-.28l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                                Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ═══ Status Bar: Connection Status, Messages, Progress, Clock ═══ -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusDot" Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                        Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                        Margin="0,0,8,0" ToolTip="System is ready" />
                    <TextBlock Grid.Column="1" x:Name="StatusLabel" Text="Ready" FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"
                        VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="2" x:Name="StatusBarText"
                        Text="Drag &amp; drop .ps1 files or browse" FontSize="12"
                        Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold"
                        VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="ProgressBar" Grid.Column="3" Width="120" Height="5"
                        VerticalAlignment="Center" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="4" x:Name="StatusTime" Text="" FontSize="12"
                        Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"
                        VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Toast Notification Overlay: Animated slide-up messages ═══ -->
        <StackPanel x:Name="ToastContainer" Grid.Column="1" VerticalAlignment="Bottom"
            HorizontalAlignment="Right" Margin="0,0,16,56" Panel.ZIndex="1000" />
    </Grid>
</Window>

